# Add these individually in Vercel Project > Settings > Environment Variables.
# Use separate infrastructure/values for Preview and Production.
NODE_ENV=production
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/music_platform?retryWrites=true&w=majority
MONGO_MAX_POOL_SIZE=10
# TCP Redis URL, not an HTTPS REST endpoint. Redis must support BullMQ commands.
REDIS_URL=rediss://default:PASSWORD@REDIS_HOST:6379
QUEUE_PREFIX=music-platform-production
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ISSUER=music-platform
JWT_AUDIENCE=music-platform-app
CORS_ORIGINS=https://admin.example.com
# For direct Vercel ingress; review if adding another proxy.
TRUST_PROXY_HOPS=1
MAX_UPLOAD_BYTES=209715200
