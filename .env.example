NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://localhost:27017/music_platform?replicaSet=rs0&directConnection=true
MONGO_MAX_POOL_SIZE=10
QUEUE_PREFIX=music-platform-local
REDIS_URL=redis://localhost:6379
# Generate: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ISSUER=music-platform
JWT_AUDIENCE=music-platform-app
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
TRUST_PROXY_HOPS=0
MAX_UPLOAD_BYTES=209715200
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Used only by `npm run seed`; keep the password in your local .env, never in source control.
ADMIN_EMAIL=testdevcits@gmail.com
ADMIN_PASSWORD=
